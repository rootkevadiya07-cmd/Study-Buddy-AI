# StudyBuddy AI Environment Configuration

# AI Provider selection: 'ollama' for local running, 'openai_compatible' for production deployment
AI_PROVIDER=ollama

# Ollama Local Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Open-Weight Production API Configuration (for Render deployment)
# Works with Groq, OpenRouter, Together, or any OpenAI-compatible provider hosting open-weight models
API_KEY=your_api_key_here
API_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=llama-3.1-8b-instant

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=600
CHUNK_OVERLAP=100
